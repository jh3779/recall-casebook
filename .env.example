# 실제 값을 채운 .env는 절대 커밋하지 않는다 (CONTRIBUTING.md '비밀값').
# 기술 스택이 확정되면 필요한 키를 여기에 추가한다.

# LLM / 임베딩
OPENAI_API_KEY=

# 벡터 DB 연결 (선택한 스토어에 맞게 수정)
VECTOR_DB_URL=

# Supabase(Postgres) 연결 문자열 — 대시보드 Connect에서 복사 (DEC-034). 사용: uv run --env-file .env python -m scripts.defect_precedent.load_db load
DATABASE_URL=

# API 서버용 조회 전용 연결 — rag_reader 계정(server/README.md 3단계, DEC-042). 서버는 관리자 연결이 없는 .env.server(이 값만)로 띄운다.
# 비어 있으면 서버가 시작하지 않는다(로컬 개발에서만 ALLOW_ADMIN_DB_FOR_SERVER=1로 DATABASE_URL 사용)
SERVER_DATABASE_URL=

# 서빙 묶음 올리기(server/rag/bundle.py upload·verify, DEC-049) — Supabase 프로젝트 주소와 Storage 쓰기용 관리자 키.
# 관리자 키는 로컬 .env에만 둔다(배포 서버·VITE_* 환경변수에 넣지 않는다). 배포 서버는 공개 주소에서 읽고 sha256을 DB 기록과 대조한다.
# 관리자 키 = 대시보드 API Keys의 Secret 키(sb_secret_…) 또는 예전 service_role 키. Publishable 키(sb_publishable_…)는 관리자 키가 아니다(2026-10-12 확인: 있는 버킷도 목록 0개·"Bucket not found"로 보였다).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 배포 서버(Vercel)용 — 서빙 묶음에서 시작(DEC-050). 배포 서버에는 SERVER_DATABASE_URL·SUPABASE_URL과 아래 값만 두고 관리자 키(DATABASE_URL·SUPABASE_SERVICE_ROLE_KEY)는 넣지 않는다.
# RAG_SOURCE가 없거나 local이면 로컬 build 파일로 뜬다(시연). SERVING_BUILD_ID는 띄울 build(예: f1fe1843ed0f2c66)
RAG_SOURCE=
SERVING_BUILD_ID=
# CORS 허용 주소(쉼표로 구분) — 비어 있으면 http://localhost:5173. 배포 화면 주소를 넣는다
ALLOWED_ORIGINS=
