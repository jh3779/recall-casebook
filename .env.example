# 실제 값을 채운 .env는 절대 커밋하지 않는다 (CONTRIBUTING.md '비밀값').
# 기술 스택이 확정되면 필요한 키를 여기에 추가한다.

# LLM / 임베딩
OPENAI_API_KEY=

# Supabase (DEC-033) — 비밀 키·DB 연결 문자열은 .env에만, 화면(frontend/) 환경변수에 넣지 않는다
SUPABASE_URL=
# 적재용 비밀 키: 대시보드 프로젝트 설정 → API Keys의 sb_secret_… (예전 service_role). 공개 키 sb_publishable_…로는 적재가 막힌다
SUPABASE_SECRET_KEY=
# DB 직접 연결 문자열(postgresql://…, 비밀번호 포함) — 나중에 뜻 검색 벡터(pgvector)를 SQL로 다룰 때만. 지금 적재에는 필요 없다
SUPABASE_DB_URL=
