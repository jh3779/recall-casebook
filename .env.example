# 실제 값을 채운 .env는 절대 커밋하지 않는다 (CONTRIBUTING.md '비밀값').
# 기술 스택이 확정되면 필요한 키를 여기에 추가한다.

# LLM / 임베딩
OPENAI_API_KEY=

# 벡터 DB 연결 (선택한 스토어에 맞게 수정)
VECTOR_DB_URL=

# Supabase(Postgres) 연결 문자열 — 대시보드 Connect에서 복사 (DEC-034). 사용: uv run --env-file .env python -m scripts.defect_precedent.load_db load
DATABASE_URL=

# API 서버용 조회 전용 연결 — rag_reader 계정(server/README.md 3단계, DEC-042). 비우면 서버가 DATABASE_URL로 읽고 경고한다(로컬 개발용)
SERVER_DATABASE_URL=
