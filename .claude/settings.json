{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(lefthook validate:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push* --force)",
      "Bash(git push* --force *)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(pip install:*)",
      "Bash(gh api*/pulls/*/merge*)",
      "Bash(gh api*mergePullRequest*)"
    ],
    "ask": [
      "Bash(git push*--force-with-lease*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
